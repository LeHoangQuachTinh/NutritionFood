    <DTS:Executable
      DTS:refId="Package\Parse Nutrition Column"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D2B42B8F-94D8-420A-93C0-20F91F881328}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Parse Nutrition Column"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4459A2EA-E0F8-4283-AF50-0618F6486A78}"
          SQLTask:SqlStatementSource="-- Thay thế nội dung trong Task ④ bằng logic này:&#xA;-- 1. Tách dữ liệu vào bảng tạm trước&#xA;SELECT &#xA;    id, &#xA;    value AS val, &#xA;    ROW_NUMBER() OVER (PARTITION BY id ORDER BY (SELECT NULL)) AS pos&#xA;INTO #NutritionSplit&#xA;FROM (&#xA;    SELECT id, REPLACE(REPLACE(nutrition,'[',''),']','') AS clean_nutrition&#xA;    FROM STG_Recipes WHERE nutrition IS NOT NULL&#xA;) p&#xA;CROSS APPLY STRING_SPLIT(p.clean_nutrition, ',');&#xA;&#xA;-- 2. Update từ bảng tạm (SQL xử lý JOIN nhanh hơn Subquery)&#xA;UPDATE s&#xA;SET &#xA;    Calories     = TRY_CAST(n1.val AS DECIMAL(10,2)),&#xA;    TotalFat_PDV = TRY_CAST(n2.val AS DECIMAL(8,2)),&#xA;    Sugar_PDV    = TRY_CAST(n3.val AS DECIMAL(8,2)),&#xA;    Sodium_PDV   = TRY_CAST(n4.val AS DECIMAL(8,2)),&#xA;    Protein_PDV  = TRY_CAST(n5.val AS DECIMAL(8,2)),&#xA;    SatFat_PDV   = TRY_CAST(n6.val AS DECIMAL(8,2)),&#xA;    Carbs_PDV    = TRY_CAST(n7.val AS DECIMAL(8,2))&#xA;FROM STG_Recipes s&#xA;LEFT JOIN #NutritionSplit n1 ON s.id = n1.id AND n1.pos = 1&#xA;LEFT JOIN #NutritionSplit n2 ON s.id = n2.id AND n2.pos = 2&#xA;LEFT JOIN #NutritionSplit n3 ON s.id = n3.id AND n3.pos = 3&#xA;LEFT JOIN #NutritionSplit n4 ON s.id = n4.id AND n4.pos = 4&#xA;LEFT JOIN #NutritionSplit n5 ON s.id = n5.id AND n5.pos = 5&#xA;LEFT JOIN #NutritionSplit n6 ON s.id = n6.id AND n6.pos = 6&#xA;LEFT JOIN #NutritionSplit n7 ON s.id = n7.id AND n7.pos = 7;&#xA;&#xA;DROP TABLE #NutritionSplit;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
