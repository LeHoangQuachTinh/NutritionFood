    <DTS:Executable
      DTS:refId="Package\Update AvgRating"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{4ED40970-A931-4349-8BAF-3888856451B7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Update AvgRating"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{43EA18C9-D6FA-4E7B-8F73-FF381D61239B}"
          SQLTask:SqlStatementSource="UPDATE dr&#xA;SET&#xA;    AvgRating   = agg.AvgRating,&#xA;    RatingCount = agg.RatingCount&#xA;FROM Dim_Recipes dr&#xA;JOIN (&#xA;    SELECT&#xA;        RecipeKey,&#xA;        AVG(CAST(Rating AS FLOAT)) AS AvgRating,&#xA;        COUNT(*) AS RatingCount&#xA;    FROM Fact_RecipeInteraction&#xA;    WHERE Rating IS NOT NULL&#xA;    GROUP BY RecipeKey&#xA;) agg ON dr.RecipeKey = agg.RecipeKey;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
