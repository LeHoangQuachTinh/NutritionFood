    <DTS:Executable
      DTS:refId="Package\Update AvgRating"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{B3B66E1F-5584-49D3-92FF-AE2A4E273996}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Update AvgRating"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{4459A2EA-E0F8-4283-AF50-0618F6486A78}"
          SQLTask:SqlStatementSource="UPDATE dr&#xA;SET&#xA;    AvgRating   = agg.AvgRating,&#xA;    RatingCount = agg.RatingCount&#xA;FROM Dim_Recipes dr&#xA;JOIN (&#xA;    SELECT&#xA;        RecipeKey,&#xA;        AVG(CAST(Rating AS FLOAT)) AS AvgRating,&#xA;        COUNT(*)                   AS RatingCount&#xA;    FROM Fact_RecipeInteraction&#xA;    WHERE Rating IS NOT NULL&#xA;    GROUP BY RecipeKey&#xA;) agg ON dr.RecipeKey = agg.RecipeKey;&#xA;&#xA;PRINT 'Updated AvgRating for ' + CAST(@@ROWCOUNT AS VARCHAR) + ' recipes';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
