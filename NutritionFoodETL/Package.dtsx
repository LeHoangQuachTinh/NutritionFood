        <ScriptProject
          Name="ST_835700b32db8456eb662e51b4b98bbb5"
          VSTAMajorVersion="16"
          VSTAMinorVersion="0"
          Language="CSharp">
          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[using System;
using System.IO;
using Microsoft.SqlServer.Dts.Runtime;

public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
{
    public void Main()
    {
        string logFolder = @"C:\ETL_Logs\";
        if (!Directory.Exists(logFolder))
            Directory.CreateDirectory(logFolder);

        string logPath = logFolder + "NutritionBI_" +
                         DateTime.Now.ToString("yyyyMMdd") + ".log";

        string msg = "[" + DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss") + "] ETL COMPLETED\n" +
                     "  Package: NutritionBI_FoodCom\n" +
                     "  Status: Success\n";

        File.AppendAllText(logPath, msg + "\n");
        Dts.TaskResult = (int)DTSExecResult.Success;
    }
}]]></ProjectItem>
