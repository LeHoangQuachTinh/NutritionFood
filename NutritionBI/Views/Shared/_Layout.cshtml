<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Food AI System</title>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <style>
        :root {
            --theme-green-1: #3b9b4a; /* Matched to the button green */
            --theme-green-2: #3b9b4a;
            --text-dark: #333333;
            --text-gray: #888888;
            --bg-light: #f5f7f6;
        }

        body {
            font-family: 'Poppins', sans-serif;
            font-size: 1.15rem; /* Tăng cỡ chữ tổng thể */
            background-image: url('/Content/HinhAnh/background.PNG');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            margin: 0;
            padding: 0;
            color: var(--text-dark);
        }

        /* Navbar */
        .navbar-custom {
            background: #ffffff;
            border-radius: 50px;
            padding: 15px 50px; /* To hơn */
            margin: 25px auto 0;
            width: 95%;
            max-width: 1500px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.05);
            border: none;
            position: relative;
        }

        .navbar-brand {
            color: var(--theme-green-1) !important;
            font-size: 28px; /* To hơn */
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        
        .navbar-brand i {
            color: var(--theme-green-1);
            font-size: 30px;
        }

        .navbar-nav .nav-link {
            color: #555555 !important;
            font-weight: 600;
            font-size: 1.1rem; /* To hơn */
            margin-left: 25px;
            padding: 10px 20px !important;
            border-radius: 20px;
            transition: all 0.2s ease;
        }

        .navbar-nav .nav-link:hover {
            color: var(--theme-green-1) !important;
            background: rgba(59, 155, 74, 0.05);
        }

        .main-content {
            padding-top: 50px;
            padding-bottom: 60px;
            min-height: calc(100vh - 120px);
            max-width: 1400px; /* Khung rộng hơn */
        }

        .footer {
            background: transparent;
            padding: 20px;
            text-align: center;
            color: #777;
            font-size: 0.95rem;
        }

        /* Card Design */
        .glass-card {
            background: #ffffff;
            border-radius: 25px; /* Bo tròn to hơn */
            box-shadow: 0 10px 50px rgba(0,0,0,0.08);
            border: none;
            overflow: hidden;
            padding: 40px 50px; /* Padding rộng hơn */
            margin-left: 5%; /* Lệch phải 1 chút theo yêu cầu */
        }

        /* Custom Headers inside Cards */
        .card-header-custom {
            background: transparent;
            padding: 10px 20px 45px;
            text-align: center;
        }
        
        .card-header-custom h2 {
            color: var(--theme-green-1);
            font-weight: 800;
            font-size: 2.2rem; /* To hơn */
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
        }
        
        .card-header-custom p {
            color: var(--text-gray);
            font-size: 1.15rem; /* To hơn */
            margin-top: 10px;
        }

        /* Stylish Input Fields */
        .form-control {
            border: 1px solid #edf1f0;
            background: #f8faf9;
            border-radius: 12px;
            padding: 18px 25px; /* Rộng hơn */
            font-weight: 600;
            font-size: 1.1rem; /* Chữ trong form to hơn */
            color: var(--text-dark);
            transition: all 0.2s ease;
            box-shadow: none;
        }

        .form-control:focus {
            background: #ffffff;
            border-color: var(--theme-green-1);
            box-shadow: 0 0 0 3px rgba(59, 155, 74, 0.1);
            outline: none;
        }

        .form-label {
            font-size: 0.9rem; /* Nhãn to hơn */
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 800;
            color: #888888;
            margin-bottom: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .form-label i {
            font-size: 1rem;
        }

        /* Button */
        .btn-theme {
            background: var(--theme-green-1);
            color: white;
            border: none;
            border-radius: 50px;
            font-size: 1.15rem; /* To hơn */
            font-weight: 700;
            padding: 18px 35px; /* Rộng hơn */
            letter-spacing: 0.5px;
            transition: all 0.2s ease;
            width: 100%;
            margin-top: 25px;
            text-transform: uppercase;
        }

        .btn-theme:hover {
            background: #32853f;
            color: white;
        }

        /* Result Area */
        .result-box {
            background: #ffffff;
            border-radius: 25px;
            padding: 40px;
            border: 1px solid #f0f0f0;
            box-shadow: 0 5px 30px rgba(0,0,0,0.04);
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
        }
        
        .result-title {
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: 0.95rem; /* To hơn */
            font-weight: 800;
            color: #aaaaaa;
            margin-bottom: 25px;
        }
        
        .result-value {
            font-size: 5rem; /* To hơn */
            font-weight: 800;
            color: var(--theme-green-1);
            line-height: 1;
            margin: 20px 0;
        }
        
        .result-badge {
            background: #f0fdf4;
            color: var(--theme-green-1);
            padding: 15px 25px; /* Rộng hơn */
            border-radius: 40px;
            font-weight: 700;
            font-size: 1rem; /* To hơn */
            border: 1px dashed #bbf7d0;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }
        
        .result-image {
            max-width: 260px; /* To hơn */
            margin: 10px auto 25px;
        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-custom">
        <div class="container-fluid">

            <a class="navbar-brand" href="/">
                <i class="fas fa-leaf"></i> NutriAI
            </a>

            <button class="navbar-toggler border-0"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarNav">
                <i class="fas fa-bars" style="color: var(--theme-green-1); font-size: 24px;"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">

                <ul class="navbar-nav ms-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="/Predict/Rating">
                            <i class="fas fa-star me-1"></i> Xếp hạng
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Predict/Healthy">
                            <i class="fas fa-heart me-1"></i> Sức khỏe
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Predict/Clusters">
                            <i class="fas fa-layer-group me-1"></i> Phân nhóm
                        </a>
                    </li>

                </ul>
            </div>
        </div>
    </nav>

    <!-- CONTENT -->
    <div class="container main-content">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer class="footer">
        <p class="mb-0">
            © @DateTime.Now.Year - Nutrition Food AI System
        </p>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("scripts", required: false)

</body>
</html>
