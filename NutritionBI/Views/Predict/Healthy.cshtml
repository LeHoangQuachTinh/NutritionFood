@model NutritionBI.Web.Models.MiningInputModel

@{
    ViewBag.Title = "Healthy Check";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-12 col-xl-11">
        <div class="glass-card">
            <div class="card-header-custom">
                <h2><i class="fas fa-heartbeat text-danger me-2"></i>Đánh giá độ lành mạnh</h2>
                <p>Hệ thống AI phân tích mức độ an toàn và lành mạnh của món ăn</p>
            </div>
            <div class="card-body p-5 pt-0">
                <div class="row align-items-stretch">
                    <!-- LEFT -->
                    <div class="col-md-6 pe-md-5 mb-5 mb-md-0">
                        <div class="mb-4">
                            <label class="form-label"><i class="fas fa-salt text-muted me-2"></i>Sodium (PDV%)</label>
                            <input type="number" id="sod" class="form-control" value="10">
                        </div>
                        <div class="mb-4">
                            <label class="form-label"><i class="fas fa-tint text-primary me-2"></i>Total Fat (PDV%)</label>
                            <input type="number" id="fat" class="form-control" value="15">
                        </div>
                        <div class="mb-4">
                            <label class="form-label"><i class="fas fa-cubes text-secondary me-2"></i>Sugar (PDV%)</label>
                            <input type="number" id="sugar" class="form-control" value="10">
                        </div>
                        <div class="form-check form-switch mb-4 p-3 rounded" style="background: #f4f9f5; border: 1px solid #e0ede4;">
                            <input class="form-check-input ms-0 me-3" type="checkbox" id="isVeg" style="width: 2.5em; height: 1.25em; cursor: pointer;">
                            <label class="form-check-label fw-bold text-success" for="isVeg" style="cursor: pointer;">
                                <i class="fas fa-leaf me-1"></i> Đây là món ăn chay?
                            </label>
                        </div>
                        <button onclick="checkHealthy()" class="btn-theme">
                            <i class="fas fa-heart me-2"></i> KIỂM TRA BẰNG AI
                        </button>
                    </div>

                    <!-- RIGHT -->
                    <div class="col-md-6">
                        <div class="result-box">
                            <div class="result-title">Xác suất lành mạnh</div>
                            <div class="progress w-100 mb-4" style="height: 30px; border-radius: 15px; background: #e8f5e9; box-shadow: inset 0 2px 5px rgba(0,0,0,0.05);">
                                <div id="hBar" class="progress-bar progress-bar-striped progress-bar-animated" 
                                     style="width:0%; background: linear-gradient(135deg, var(--theme-green-1), var(--theme-green-2)); font-weight: bold; font-size: 1.1rem;">
                                    0%
                                </div>
                            </div>
                            <h2 id="resHealthy" class="result-value" style="font-size: 2.5rem;">--</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function checkHealthy() {
        const input = {
            Sodium_PDV: parseFloat($('#sod').val()) || 0,
            TotalFat_PDV: parseFloat($('#fat').val()) || 0,
            Sugar_PDV: parseFloat($('#sugar').val()) || 0,
            IsVegetarian: $('#isVeg').is(':checked') ? 1 : 0
        };

        $.ajax({
            url: '@Url.Action("AnalyzeHealthy", "Predict")',
            type: 'POST',
            data: JSON.stringify(input),
            contentType: 'application/json',
            success: function (res) {
                if (res.success) {
                    let prob = (res.data.HealthyProbability * 100).toFixed(1);
                    $('#hBar').css('width', prob + '%').text(prob + '%');

                    $('#resHealthy').text(res.data.IsHealthy
                        ? "LÀNH MẠNH ✅"
                        : "KHÔNG LÀNH MẠNH ❌");

                    if (res.data.IsHealthy) {
                        $('#hBar').removeClass('bg-secondary bg-danger').addClass('bg-success');
                    } else {
                        $('#hBar').removeClass('bg-secondary bg-success').addClass('bg-danger');
                    }
                } else {
                    alert("Lỗi: " + (res.message || "Không xác định"));
                }
            },
            error: function (xhr) {
                alert("Lỗi kết nối: " + xhr.statusText);
            }
        });
    }
</script>
