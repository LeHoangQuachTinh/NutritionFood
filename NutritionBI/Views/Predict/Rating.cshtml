@model NutritionBI.Web.Models.MiningInputModel

@{
    ViewBag.Title = "Rating Prediction";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-12 col-xl-11">
        <div class="glass-card">
            <div class="card-header-custom">
                <h2><i class="fas fa-star me-2"></i>Dự đoán Xếp hạng</h2>
                <p>AI sẽ phân tích thành phần dinh dưỡng và đưa ra mức đánh giá dự kiến</p>
            </div>
            <div class="card-body p-4 pt-0">
                <div class="row align-items-stretch">
                    <!-- LEFT -->
                    <div class="col-md-7 pe-md-5 mb-5 mb-md-0">
                        <div class="row">
                            <div class="col-sm-6 mb-3">
                                <label class="form-label"><i class="fas fa-fire-alt text-warning"></i> Calories (kcal)</label>
                                <input type="number" id="cal" class="form-control" value="450">
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label class="form-label"><i class="fas fa-dumbbell text-info"></i> Protein (PDV%)</label>
                                <input type="number" id="pro" class="form-control" value="25">
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label class="form-label"><i class="fas fa-bread-slice text-secondary"></i> Carbs (PDV%)</label>
                                <input type="number" id="carb" class="form-control" value="50">
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label class="form-label"><i class="fas fa-tint text-primary"></i> Total Fat (PDV%)</label>
                                <input type="number" id="fat" class="form-control" value="15">
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label class="form-label"><i class="fas fa-cubes text-secondary"></i> Sugar (PDV%)</label>
                                <input type="number" id="sugar" class="form-control" value="10">
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label class="form-label"><i class="fas fa-flask text-muted"></i> Sodium (PDV%)</label>
                                <input type="number" id="sod" class="form-control" value="10">
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label class="form-label"><i class="fas fa-clock text-dark"></i> Cook Time (min)</label>
                                <input type="number" id="min" class="form-control" value="30">
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label class="form-label"><i class="fas fa-leaf text-success"></i> Vegetarian?</label>
                                <select id="isVeg" class="form-control">
                                    <option value="0">Không</option>
                                    <option value="1">Có</option>
                                </select>
                            </div>
                            <div class="col-sm-6 mb-3">
                                <label class="form-label"><i class="fas fa-list-ol text-info"></i> N Ingredients</label>
                                <input type="number" id="nIng" class="form-control" value="5">
                            </div>
                        </div>
                        <button onclick="predictRating()" class="btn-theme mt-2">
                            <i class="fas fa-magic me-2"></i> PHÂN TÍCH BẰNG AI
                        </button>
                    </div>

                    <!-- RIGHT -->
                    <div class="col-md-5">
                        <div class="result-box">
                            <div class="result-title">Kết quả dự đoán</div>
                            <div id="resRating" class="result-value">--</div>
                            <div id="resConf" class="result-badge">
                                <i class="fas fa-clock me-1"></i> Đang chờ dữ liệu...
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function predictRating() {
        const input = {
            Calories: parseFloat($('#cal').val()) || 0,
            Protein_PDV: parseFloat($('#pro').val()) || 0,
            Carbs_PDV: parseFloat($('#carb').val()) || 0,
            TotalFat_PDV: parseFloat($('#fat').val()) || 0,
            Sugar_PDV: parseFloat($('#sugar').val()) || 0,
            Sodium_PDV: parseFloat($('#sod').val()) || 0,
            Minutes: parseInt($('#min').val()) || 0,
            IsVegetarian: parseInt($('#isVeg').val()) || 0,
            N_Ingredients: parseInt($('#nIng').val()) || 0
        };

        $.ajax({
            url: '@Url.Action("AnalyzeRating", "Predict")',
            type: 'POST',
            data: JSON.stringify(input),
            contentType: 'application/json',
            success: function (res) {
                if (res.success && res.data) {
                    $('#resRating').fadeOut(200, function () {
                        $(this).text(res.data.PredictedRating || '--').fadeIn();
                    });
                    $('#resConf').text("Độ tin cậy: " + (res.data.DtConfidence * 100).toFixed(1) + "%");
                } else {
                    alert("Có lỗi: " + (res.message || "Không có dữ liệu trả về"));
                }
            },
            error: function (xhr) {
                alert("Lỗi kết nối Server!");
                console.error(xhr.responseText);
            }
        });
    }
</script>
