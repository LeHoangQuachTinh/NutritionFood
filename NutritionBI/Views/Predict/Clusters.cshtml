@model NutritionBI.Web.Models.MiningInputModel

@{
    ViewBag.Title = "Food Clustering";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="glass-card">
            <div class="bg-success text-white text-center py-4">
                <h2 class="fw-bold">
                    <i class="fas fa-layer-group"></i>
                    Phân nhóm món ăn AI
                </h2>
            </div>
            <div class="card-body p-5">
                <div class="row align-items-center">
                    <!-- LEFT -->
                    <div class="col-md-5 border-end">
                        <h4 class="text-success fw-bold mb-4">
                            Thông số dinh dưỡng
                        </h4>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Total Fat (PDV%)</label>
                            <input type="number" id="fat" class="form-control" value="15">
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Sugar (PDV%)</label>
                            <input type="number" id="sugar" class="form-control" value="10">
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-semibold">Calories (kcal)</label>
                            <input type="number" id="cal" class="form-control" value="450">
                        </div>
                        <button onclick="getCluster()" class="btn btn-success btn-custom w-100">
                            <i class="fas fa-project-diagram"></i> PHÂN NHÓM AI
                        </button>
                    </div>

                    <!-- RIGHT -->
                    <div class="col-md-7 text-center">
                        <div class="result-box">
                            <div id="cluEmoji" style="font-size:100px;" class="mb-3">🍽️</div>
                            <h1 id="resCluster" class="fw-bold text-success display-5">--</h1>
                            <p class="text-muted mt-3">AI phân tích nhóm món ăn tự nhiên</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function getCluster() {
        const input = {
            TotalFat_PDV: parseFloat($('#fat').val()) || 0,
            Sugar_PDV: parseFloat($('#sugar').val()) || 0,
            Calories: parseFloat($('#cal').val()) || 0
        };

        $.ajax({
            url: '@Url.Action("AnalyzeCluster", "Predict")',
            type: 'POST',
            data: JSON.stringify(input),
            contentType: 'application/json',
            success: function (res) {
                if (res.success) {
                    $('#cluEmoji').text(res.data.ClusterEmoji || '🍽️');
                    $('#resCluster').text(res.data.ClusterLabel || 'Không xác định nhóm');
                } else {
                    alert("Lỗi: " + (res.message || "Không xác định"));
                }
            },
            error: function (xhr) {
                alert("Lỗi kết nối: " + xhr.statusText);
            }
        });
    }
</script>