                  <xs:element name="TimeCategory" msdata:ReadOnly="true" msprop:design-time-name="ed721b50-8277-47d6-a8c0-acc5f836bfc8" msprop:IsLogical="True" msprop:Description="" msprop:DbColumnName="TimeCategory" msprop:ComputedColumnExpression="CASE&#xD;&#xA;       WHEN Minutes &lt;= 15  THEN 'Ultra Quick (≤15m)'&#xD;&#xA;       WHEN Minutes &lt;= 30  THEN 'Quick (16-30m)'&#xD;&#xA;       WHEN Minutes &lt;= 60  THEN 'Moderate (31-60m)'&#xD;&#xA;       WHEN Minutes &lt;= 120 THEN 'Long (1-2h)'&#xD;&#xA;       ELSE 'Very Long (2h+)'&#xD;&#xA;   END">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="18" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                  <xs:element name="NutritionScore" msdata:ReadOnly="true" msprop:design-time-name="c79f1413-3fbb-4fe8-826b-13a278ee1123" msprop:IsLogical="True" msprop:Description="" msprop:DbColumnName="NutritionScore" msprop:ComputedColumnExpression="CASE&#xD;&#xA;       WHEN Calories IS NULL THEN 0&#xD;&#xA;       ELSE&#xD;&#xA;           (CASE WHEN Protein_PDV BETWEEN 10 AND 40 THEN 30 ELSE 0 END) +&#xD;&#xA;           (CASE WHEN Carbs_PDV   BETWEEN 20 AND 60 THEN 30 ELSE 0 END) +&#xD;&#xA;           (CASE WHEN TotalFat_PDV &lt; 30              THEN 25 ELSE 0 END) +&#xD;&#xA;           (CASE WHEN Calories &lt; 600                 THEN 15 ELSE 0 END)&#xD;&#xA;   END" type="xs:int" minOccurs="0" />
                  <xs:element name="CalorieCategory" msdata:ReadOnly="true" msprop:design-time-name="e47917c9-3792-479a-9833-3c612ebacfde" msprop:IsLogical="True" msprop:Description="" msprop:DbColumnName="CalorieCategory" msprop:ComputedColumnExpression="CASE&#xD;&#xA;    WHEN Calories &lt; 200  THEN 'Very Low (&lt;200)'&#xD;&#xA;    WHEN Calories &lt; 400  THEN 'Low (200-400)'&#xD;&#xA;    WHEN Calories &lt; 600  THEN 'Medium (400-600)'&#xD;&#xA;    WHEN Calories &lt; 800  THEN 'High (600-800)'&#xD;&#xA;    ELSE 'Very High (800+)'&#xD;&#xA;END">
                    <xs:simpleType>
                      <xs:restriction base="xs:string">
                        <xs:maxLength value="16" />
                      </xs:restriction>
                    </xs:simpleType>
                  </xs:element>
                </xs:sequence>
              </xs:complexType>
            </xs:element>
