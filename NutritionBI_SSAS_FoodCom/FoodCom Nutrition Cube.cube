  <Source dwd:design-time-name="ad52e123-1f6f-416a-a095-03d3b1e6e90a">
    <DataSourceViewID>Nutrition DW Food Com</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="34d34bae-541e-47c5-b755-f3c030300190">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>CALCULATE;
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Rating] AS IIF([Measures].[InteractionID Count] = 0, NULL, [Measures].[Sum of Ratings] / [Measures].[InteractionID Count]), FORMAT_STRING = "#0.00", VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Calories] AS IIF([Measures].[InteractionID Count] = 0, NULL, [Measures].[Calories] / [Measures].[InteractionID Count]), FORMAT_STRING = "#,##0.0", VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Protein Ratio %] AS IIF([Measures].[Calories] = 0, NULL, ([Measures].[Protein_PDV] / [Measures].[InteractionID Count]) * 50.0 / 100 * 4.0 / ([Measures].[Calories] / [Measures].[InteractionID Count]) * 100), FORMAT_STRING = "#0.0", VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Carb Ratio %] AS IIF([Measures].[Calories] = 0, NULL, ([Measures].[Carbs_PDV] / [Measures].[InteractionID Count]) * 275.0 / 100 * 4.0 / ([Measures].[Calories] / [Measures].[InteractionID Count]) * 100), FORMAT_STRING = "#0.0", VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Fat Ratio %] AS IIF([Measures].[Calories] = 0, NULL, ([Measures].[Total Fat_PDV] / [Measures].[InteractionID Count]) * 78.0 / 100 * 9.0 / ([Measures].[Calories] / [Measures].[InteractionID Count]) * 100), FORMAT_STRING = "#0.0", VISIBLE = 1;
CREATE MEMBER CURRENTCUBE.[Measures].[Review Rate %] AS IIF([Measures].[InteractionID Count] = 0, NULL, [Measures].[Total Reviews] / [Measures].[InteractionID Count] * 100), FORMAT_STRING = "#0.0%", VISIBLE = 1;</Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="a33a61ef-8eea-465f-b18a-2964703ff8e0">
      <ID>KPI</ID>
      <Name>Recipe Quality</Name>
      <Value>[Measures].[Avg Rating]</Value>
      <Goal>4.0</Goal>
      <Status>CASE
        WHEN KpiValue("Recipe Quality") &gt;= 4.5 THEN 1
        WHEN KpiValue("Recipe Quality") &gt;= 3.5 THEN 0
        ELSE -1
     END</Status>
      <Trend>0</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>